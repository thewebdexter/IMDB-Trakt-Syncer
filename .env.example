# Copy to .env and fill in. Never commit .env.
# Values here are written into /data/credentials.txt on start-up, so the
# interactive prompts are skipped. Leave a value empty to be prompted in `setup`.

# --- Trakt API app (https://trakt.tv/oauth/applications, redirect uri: urn:ietf:wg:oauth:2.0:oob)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# --- IMDB login (email or phone). Use a unique password: it is stored in plain text in ./data
IMDB_USERNAME=
IMDB_PASSWORD=

# --- What to sync (true/false)
SYNC_WATCHLIST=true
SYNC_RATINGS=true
SYNC_REVIEWS=false
SYNC_WATCH_HISTORY=true
REMOVE_WATCHED_FROM_WATCHLISTS=false
MARK_RATED_AS_WATCHED=false
# Remove watchlist items older than N days (0 = off)
REMOVE_WATCHLIST_ITEMS_OLDER_THAN_DAYS=0

# --- Schedule
# Hours between syncs. Each sync logs in to IMDB; very frequent logins raise captcha risk.
SYNC_INTERVAL_HOURS=6
# Random extra delay (minutes) added to each interval
SYNC_JITTER_MINUTES=20
# Kill a sync (and its browser) that runs longer than this. The first sync of a big
# library can take hours; anything unfinished is picked up by the next run.
RUN_TIMEOUT_HOURS=8
# CPU priority of the sync process (0-19, higher = nicer to other workloads)
SYNC_NICE=10

# --- Efficiency
# Do not download images in the browser: less CPU, RAM and bandwidth per IMDB page.
# Optional: turn on, run one sync, and check that ratings/watchlist items were set.
IMDBTRAKTSYNCER_BLOCK_IMAGES=false

# --- Container resource caps (docker-compose.yml)
SYNC_CPUS=2
SYNC_MEM_LIMIT=2g
